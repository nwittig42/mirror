# Database
DATABASE_URL="postgres://user:password@host:5432/dbname"

# LLM vendor API keys (required). These four engines are asked every prompt,
# every week, about every business.
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GEMINI_API_KEY="..."
PERPLEXITY_API_KEY="pplx-..."
# Optional fifth engine: Grok joins the scan only when this is set.
# XAI_API_KEY="xai-..."

# LLM vendor model IDs (optional; defaults shown, override to change models)
OPENAI_MODEL="gpt-5.1"
ANTHROPIC_MODEL="claude-sonnet-5"
GEMINI_MODEL="gemini-3.6-flash"
PERPLEXITY_MODEL="sonar-pro"
# GROK_MODEL="grok-4"
# The fact judge, the tone rater and the competitor extractor run on this one.
# The question and fact drafters use ANTHROPIC_MODEL.
JUDGE_MODEL="claude-haiku-4-5-20251001"

# Scan
# Times each prompt is asked of each engine per scan (1 to 5, default 3).
# Answers vary between identical requests, so the score is built from several
# runs. Each extra run adds roughly a third to scan time and engine cost.
# SCAN_RUNS=3

# Email
RESEND_API_KEY="re_..."
EMAIL_FROM="onboarding@resend.dev"
# Inbound audit requests from the public /book form, including the optional
# "What kind of business is it?" and "City or area" answers. Falls back to
# OPERATOR_EMAIL.
LEADS_EMAIL="leads@your-domain.example.com"
# Internal accuracy alerts when a scan finds a new critical/major wrong fact
# about a business. Never sent to clients; they get the weekly Pulse the next
# morning. Falls back to OPERATOR_EMAIL.
ALERT_EMAIL="alerts@your-domain.example.com"
# Where client "Need help?" requests from the dashboard's Help tab go. Falls
# back to OPERATOR_EMAIL.
# SUPPORT_EMAIL="help@your-domain.example.com"

# Cron
CRON_SECRET="change-me"
# Set by Vercel when Protection Bypass for Automation is on. Lets the weekly
# cron call its own per-business scan route on a protected deployment.
# VERCEL_AUTOMATION_BYPASS_SECRET=""

# Auth
AUTH_SECRET="change-me"
# Set to your canonical https URL in production. Pins magic-link URLs to
# your domain instead of trusting the request's Host header.
AUTH_URL="https://your-domain.example.com"
OPERATOR_EMAIL="operator@example.com"
# Bootstrap only. Seeds the operator's scrypt hash on their first sign-in, then
# stops being consulted, so changing the operator password in the app really
# does retire this value. Clearing users.password_hash re-arms it.
OPERATOR_PASSWORD="change-me-dev-only"

# Scheduling
# Calendly event link shown after the /book form is submitted. Optional: unset,
# the form falls back to a "we'll email you within one business day" panel.
CALENDLY_URL="https://calendly.com/you/15min"

# App
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Mirror"
